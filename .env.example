# Copy to .env for local runs; never commit .env. Every setting is read with the PARKING_ prefix.
# `make demo` (a later PR) will generate random local API keys for you; until then set your own.
# Values below are the defaults unless marked as a placeholder.

# dev | test | prod. prod requires the three API keys and forbids SQLite and a "*" CORS origin.
PARKING_ENV=dev
PARKING_DATABASE_URL=postgresql+asyncpg://parking:parking@localhost:5432/parking
# JSON list. "*" is accepted only when PARKING_ENV=dev.
PARKING_CORS_ORIGINS=["http://localhost:5173"]

# API keys sent in the X-API-Key header: at least 32 characters, optional in dev and test,
# required in prod, and all three must differ. Generate each one yourself, for example with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keys starting with "change-me" are rejected in prod.
# PARKING_INGEST_API_KEY=
# PARKING_ADMIN_API_KEY=
# PARKING_OPERATOR_API_KEY=

# IANA time zone that defines the service date.
PARKING_TIMEZONE=America/Fortaleza
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PARKING_LOG_LEVEL=INFO
# json | text
PARKING_LOG_FORMAT=json

# Readiness probe: seconds before the database check in /readyz gives up.
PARKING_READINESS_TIMEOUT_S=2

# Ingestion (used from the ingestion PR on)
PARKING_INGEST_MAX_BATCH=1000
PARKING_INGEST_MAX_CONCURRENCY=4
PARKING_INGEST_LOCK_TIMEOUT_MS=2000
# Events later than now + this many seconds are rejected as in_future.
PARKING_MAX_CLOCK_SKEW_S=300
# Events older than this many days are rejected as too_old.
PARKING_MAX_EVENT_AGE_DAYS=120

# Live availability (real-time PR)
PARKING_LIVE_POLL_INTERVAL_S=1
PARKING_LIVE_HEARTBEAT_S=15
PARKING_LIVE_MAX_CONNECTIONS=500

# Worker and batch jobs (worker and warehouse PRs)
PARKING_LAKE_DIR=data/lake
PARKING_DBT_PROJECT_DIR=warehouse
PARKING_WAREHOUSE_INTERVAL_MIN=15
# Local time (service time zone) after which the daily run starts.
PARKING_DAILY_RUN_AT=00:30
PARKING_WORKER_POLL_S=2
PARKING_WORKER_METRICS_PORT=9100

# Tests only: a real Postgres for `pytest -m integration` (integration PR).
# TEST_DATABASE_URL=postgresql+asyncpg://parking:parking@localhost:5432/parking_test
