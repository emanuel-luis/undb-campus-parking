# Copy to .env for local runs; never commit .env. Every setting is read with the PARKING_ prefix.
# `make demo` (a later PR) will generate random local API keys for you; until then set your own.
# Values below are the defaults unless marked as a placeholder.

# dev | test | prod. prod requires the three API keys and forbids SQLite and a "*" CORS origin.
PARKING_ENV=dev
PARKING_DATABASE_URL=postgresql+asyncpg://parking:parking@localhost:5432/parking
# JSON list. "*" is accepted only when PARKING_ENV=dev.
PARKING_CORS_ORIGINS=["http://localhost:5173"]

# API keys sent in the X-API-Key header: at least 32 characters, optional in dev and test,
# required in prod, and all three must differ. Generate each one yourself, for example with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keys starting with "change-me" are rejected in prod.
# PARKING_INGEST_API_KEY=
# PARKING_ADMIN_API_KEY=
# PARKING_OPERATOR_API_KEY=

# IANA time zone that defines the service date.
PARKING_TIMEZONE=America/Fortaleza
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PARKING_LOG_LEVEL=INFO
# json | text
PARKING_LOG_FORMAT=json

# Readiness probe: seconds before the database check in /readyz gives up.
PARKING_READINESS_TIMEOUT_S=2

# Ingestion (used from the ingestion PR on)
PARKING_INGEST_MAX_BATCH=1000
PARKING_INGEST_MAX_CONCURRENCY=4
PARKING_INGEST_LOCK_TIMEOUT_MS=2000
# Events later than now + this many seconds are rejected as in_future.
PARKING_MAX_CLOCK_SKEW_S=300
# Events older than this many days are rejected as too_old.
PARKING_MAX_EVENT_AGE_DAYS=120

# Live availability (real-time PR)
PARKING_LIVE_POLL_INTERVAL_S=1
PARKING_LIVE_HEARTBEAT_S=15
PARKING_LIVE_MAX_CONNECTIONS=500

# Worker and batch jobs (worker and warehouse PRs)
PARKING_LAKE_DIR=data/lake
# The dbt project (backend/warehouse), relative to the worker's working directory. The worker
# runs dbt with DBT_PG_* derived from PARKING_DATABASE_URL; set those yourself to run dbt by hand:
#   DBT_PG_HOST=localhost DBT_PG_PORT=5432 DBT_PG_USER=parking DBT_PG_PASSWORD=... DBT_PG_DBNAME=parking
PARKING_DBT_PROJECT_DIR=warehouse
# Minutes between scheduled warehouse/incremental runs (dbt build).
PARKING_WAREHOUSE_INTERVAL_MIN=15
# Local time (service time zone) after which the daily run starts.
PARKING_DAILY_RUN_AT=00:30
PARKING_WORKER_POLL_S=2
# Prometheus exporter of the worker; 0 turns it off.
PARKING_WORKER_METRICS_PORT=9100
# Touched every few seconds while the worker runs (the Docker HEALTHCHECK reads it).
PARKING_WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
# PARKING_LAKE_DIR is the Parquet archive root: raw/gate_events/service_date=YYYY-MM-DD/ and
# raw/ingest_rejects/received_date=YYYY-MM-DD/, written by close-day, export and the daily job.

# Local Postgres from compose.yaml (`make up-db`). Local-only credentials: never reuse them on a
# shared or production database. These are the defaults when unset.
# POSTGRES_USER=parking
# POSTGRES_PASSWORD=parking
# POSTGRES_DB=parking
# POSTGRES_PORT=5432

# Tests only: a real Postgres for `make test-integration` (pytest -m integration). The suite
# creates this database if it is missing and resets its public schema before every test, so point
# it at a throwaway database, never at the application one. This is the default in the Makefile.
# TEST_DATABASE_URL=postgresql+asyncpg://parking:parking@localhost:5432/parking_test

# Turnstile generator (generator/, read with the GENERATOR_ prefix). It is an API client: it only
# needs the backend URL and the ingest and admin keys, the same values as the PARKING_ ones above.
# GENERATOR_API_URL=http://localhost:8000
# GENERATOR_INGEST_API_KEY=
# GENERATOR_ADMIN_API_KEY=
# Same seed and student count give the same registry and the same events (ids are uuid5).
# GENERATOR_SEED=42
# GENERATOR_STUDENTS=10000
# normal | rush_hour | quiet
# GENERATOR_SCENARIO=normal
# GENERATOR_RATE_MULTIPLIER=1.0
# Live mode never goes below this many arrivals per minute across all lots.
# GENERATOR_MIN_RATE_PER_MIN=2
# GENERATOR_BATCH_SIZE=50
# GENERATOR_BACKFILL_BATCH_SIZE=1000
# `turnstile-gen run` backfills this many past days before going live (0 = none).
# GENERATOR_BACKFILL_DAYS=0
# GENERATOR_FLUSH_INTERVAL_S=5
# GENERATOR_OUTBOX_MAX=20000
# GENERATOR_TIMEZONE=America/Fortaleza
# Synthetic assumption: the semester starts on this date; the week before it is quiet.
# GENERATOR_SEMESTER_START=2026-08-03
# Fault rates, each 0..1 (injected on purpose so the backend's reject paths are exercised).
# GENERATOR_FAULT_DUPLICATE_RATE=0.01
# GENERATOR_FAULT_OUT_OF_ORDER_RATE=0.02
# GENERATOR_FAULT_MISSING_EXIT_RATE=0.01
# GENERATOR_FAULT_MISSING_ENTRY_RATE=0.005
# GENERATOR_FAULT_UNKNOWN_STUDENT_RATE=0.002
# GENERATOR_FAULT_UNKNOWN_GATE_RATE=0.001
# Heartbeat file touched while running; `turnstile-gen healthcheck` exits 0 if it is fresh.
# GENERATOR_HEARTBEAT_FILE=
# GENERATOR_HEARTBEAT_MAX_AGE_S=120
# GENERATOR_LOG_LEVEL=INFO
