* text=auto
Makefile text eol=lf
*.sh text eol=lf
*.d2 text eol=lf
*.py text eol=lf
# Written with LF by `campus-parking openapi`; make openapi-check compares the bytes.
backend/openapi.json text eol=lf
*.parquet binary
*.png binary
# Rendered diagrams: keep the bytes D2 writes (no EOL conversion, so make diagrams-check compares
# exactly what CI renders) and collapse them in PR diffs; review the .d2 source instead.
*.svg -text
docs/diagrams/*.svg linguist-generated=true
# Generated from the API's OpenAPI schema (make api-client); review the schema instead.
packages/api-client/src/schema.ts linguist-generated=true
