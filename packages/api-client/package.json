{
  "name": "@undb-campus-parking/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../../backend/openapi.json -o src/schema.ts",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.105.0",
    "react": "19.2.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/react-query": "5.105.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "react": "19.2.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
