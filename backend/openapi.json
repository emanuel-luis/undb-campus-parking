{
  "components": {
    "schemas": {
      "AvailabilitySnapshot": {
        "properties": {
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "lots": {
            "description": "Sorted by lot_id.",
            "items": {
              "$ref": "#/components/schemas/LotAvailability"
            },
            "title": "Lots",
            "type": "array"
          }
        },
        "required": [
          "generated_at",
          "lots"
        ],
        "title": "AvailabilitySnapshot",
        "type": "object"
      },
      "BulkUpsertResult": {
        "properties": {
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "unchanged": {
            "title": "Unchanged",
            "type": "integer"
          }
        },
        "required": [
          "created",
          "unchanged"
        ],
        "title": "BulkUpsertResult",
        "type": "object"
      },
      "CapacityPeriod": {
        "description": "Capacity valid from this local date until the next period starts.",
        "properties": {
          "capacity": {
            "exclusiveMinimum": 0.0,
            "title": "Capacity",
            "type": "integer"
          },
          "valid_from": {
            "format": "date",
            "title": "Valid From",
            "type": "string"
          }
        },
        "required": [
          "valid_from",
          "capacity"
        ],
        "title": "CapacityPeriod",
        "type": "object"
      },
      "GateEvent": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "enum": [
              "entry",
              "exit"
            ],
            "title": "Direction",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "gate_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Gate Id",
            "type": "string"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "student_ref": {
            "pattern": "^stu_[0-9a-f]{12}$",
            "title": "Student Ref",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "gate_id",
          "lot_id",
          "direction",
          "student_ref",
          "occurred_at"
        ],
        "title": "GateEvent",
        "type": "object"
      },
      "GateHealth": {
        "properties": {
          "gate_id": {
            "title": "Gate Id",
            "type": "string"
          },
          "last_event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Event At"
          },
          "last_received_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Received At"
          },
          "lot_id": {
            "title": "Lot Id",
            "type": "string"
          }
        },
        "required": [
          "gate_id",
          "lot_id",
          "last_event_at",
          "last_received_at"
        ],
        "title": "GateHealth",
        "type": "object"
      },
      "GateOut": {
        "properties": {
          "direction": {
            "enum": [
              "entry",
              "exit"
            ],
            "title": "Direction",
            "type": "string"
          },
          "gate_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Gate Id",
            "type": "string"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "gate_id",
          "lot_id",
          "direction",
          "name"
        ],
        "title": "GateOut",
        "type": "object"
      },
      "GateUpsert": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "enum": [
              "entry",
              "exit"
            ],
            "title": "Direction",
            "type": "string"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "lot_id",
          "direction",
          "name"
        ],
        "title": "GateUpsert",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthStatus",
        "type": "object"
      },
      "IngestResult": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "batch_id": {
            "format": "uuid",
            "title": "Batch Id",
            "type": "string"
          },
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          },
          "received": {
            "title": "Received",
            "type": "integer"
          },
          "rejected": {
            "title": "Rejected",
            "type": "integer"
          },
          "rejects": {
            "items": {
              "$ref": "#/components/schemas/RejectItem"
            },
            "title": "Rejects",
            "type": "array"
          }
        },
        "required": [
          "batch_id",
          "received",
          "accepted",
          "duplicates",
          "rejected",
          "rejects"
        ],
        "title": "IngestResult",
        "type": "object"
      },
      "IngestionHealth": {
        "properties": {
          "gates": {
            "items": {
              "$ref": "#/components/schemas/GateHealth"
            },
            "title": "Gates",
            "type": "array"
          },
          "lag": {
            "$ref": "#/components/schemas/Lag",
            "description": "Arrival lag of accepted events in the window."
          },
          "last_batch_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Batch At"
          },
          "per_minute": {
            "description": "Minutes with at least one batch, oldest first.",
            "items": {
              "$ref": "#/components/schemas/MinuteCount"
            },
            "title": "Per Minute",
            "type": "array"
          },
          "rejects_by_reason": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Rejects By Reason",
            "type": "object"
          }
        },
        "required": [
          "per_minute",
          "rejects_by_reason",
          "lag",
          "gates",
          "last_batch_at"
        ],
        "title": "IngestionHealth",
        "type": "object"
      },
      "Lag": {
        "properties": {
          "avg_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg S"
          },
          "max_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max S"
          }
        },
        "required": [
          "avg_s",
          "max_s"
        ],
        "title": "Lag",
        "type": "object"
      },
      "LotAvailability": {
        "properties": {
          "capacity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Current capacity; null before the first period starts.",
            "title": "Capacity"
          },
          "free": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "max(capacity - occupied, 0); null without a capacity.",
            "title": "Free"
          },
          "last_event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Event At"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "occupancy_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "occupied / capacity, in percent, 1 decimal.",
            "title": "Occupancy Pct"
          },
          "occupied": {
            "description": "Open stays, exact (may exceed capacity).",
            "title": "Occupied",
            "type": "integer"
          },
          "over_capacity": {
            "title": "Over Capacity",
            "type": "boolean"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "description": "Increases whenever an accepted event changes the lot.",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "lot_id",
          "name",
          "capacity",
          "occupied",
          "free",
          "occupancy_pct",
          "over_capacity",
          "version",
          "updated_at",
          "last_event_at"
        ],
        "title": "LotAvailability",
        "type": "object"
      },
      "LotOut": {
        "properties": {
          "capacity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Capacity of the period with the latest valid_from on or before today (service time zone). Null when every period starts in the future: there is no current capacity yet.",
            "title": "Capacity"
          },
          "capacity_history": {
            "description": "Sorted by valid_from.",
            "items": {
              "$ref": "#/components/schemas/CapacityPeriod"
            },
            "title": "Capacity History",
            "type": "array"
          },
          "gates": {
            "description": "Sorted by gate_id.",
            "items": {
              "$ref": "#/components/schemas/GateOut"
            },
            "title": "Gates",
            "type": "array"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "lot_id",
          "name",
          "capacity",
          "capacity_history",
          "gates"
        ],
        "title": "LotOut",
        "type": "object"
      },
      "LotUpsert": {
        "additionalProperties": false,
        "properties": {
          "capacity_history": {
            "items": {
              "$ref": "#/components/schemas/CapacityPeriod"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Capacity History",
            "type": "array"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "capacity_history"
        ],
        "title": "LotUpsert",
        "type": "object"
      },
      "MinuteCount": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          },
          "minute": {
            "format": "date-time",
            "title": "Minute",
            "type": "string"
          },
          "rejected": {
            "title": "Rejected",
            "type": "integer"
          }
        },
        "required": [
          "minute",
          "accepted",
          "duplicates",
          "rejected"
        ],
        "title": "MinuteCount",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "database": {
            "const": "ok",
            "default": "ok",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Readiness",
        "type": "object"
      },
      "RejectItem": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "index": {
            "description": "Position of the item in the request array.",
            "title": "Index",
            "type": "integer"
          },
          "reason": {
            "enum": [
              "schema_invalid",
              "unknown_gate",
              "unknown_student",
              "lot_mismatch",
              "direction_mismatch",
              "in_future",
              "too_old",
              "event_id_conflict"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "index",
          "reason",
          "detail"
        ],
        "title": "RejectItem",
        "type": "object"
      },
      "RejectOut": {
        "properties": {
          "batch_id": {
            "format": "uuid",
            "title": "Batch Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "gate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gate Id"
          },
          "lot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Id"
          },
          "payload": {
            "description": "The item as received, capped at 4 KB.",
            "title": "Payload"
          },
          "reason": {
            "enum": [
              "schema_invalid",
              "unknown_gate",
              "unknown_student",
              "lot_mismatch",
              "direction_mismatch",
              "in_future",
              "too_old",
              "event_id_conflict"
            ],
            "title": "Reason",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "reject_id": {
            "title": "Reject Id",
            "type": "integer"
          },
          "service_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Date"
          }
        },
        "required": [
          "reject_id",
          "batch_id",
          "received_at",
          "event_id",
          "service_date",
          "lot_id",
          "gate_id",
          "reason",
          "detail",
          "payload"
        ],
        "title": "RejectOut",
        "type": "object"
      },
      "RejectPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RejectOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` for the next page; null at the end.",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "RejectPage",
        "type": "object"
      },
      "StudentBulkUpsert": {
        "additionalProperties": false,
        "properties": {
          "student_refs": {
            "description": "Repeated refs in one body count once.",
            "items": {
              "pattern": "^stu_[0-9a-f]{12}$",
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Student Refs",
            "type": "array"
          }
        },
        "required": [
          "student_refs"
        ],
        "title": "StudentBulkUpsert",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "UNDB Campus Parking API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/gates/{gate_id}": {
      "put": {
        "description": "A gate's lot and direction are fixed from creation; only the name may change. 201 when created, 200 when it existed.",
        "operationId": "put_gate_api_v1_admin_gates__gate_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "gate_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9-]{2,40}$",
              "title": "Gate Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GateUpsert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateOut"
                }
              }
            },
            "description": "Gate created."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create or rename a gate",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/lots/{lot_id}": {
      "put": {
        "description": "Replaces the lot's name and its whole capacity history; the same body twice leaves the same state. 201 when the lot was created, 200 when it existed.",
        "operationId": "put_lot_api_v1_admin_lots__lot_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "lot_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9-]{2,40}$",
              "title": "Lot Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LotUpsert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotOut"
                }
              }
            },
            "description": "Lot created."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create or replace a lot",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/students/bulk": {
      "post": {
        "description": "Insert-ignore: known refs are left as they are. Repeats in the body count once.",
        "operationId": "bulk_students_api_v1_admin_students_bulk_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentBulkUpsert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
