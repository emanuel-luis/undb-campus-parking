{
  "components": {
    "schemas": {
      "BulkUpsertResult": {
        "properties": {
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "unchanged": {
            "title": "Unchanged",
            "type": "integer"
          }
        },
        "required": [
          "created",
          "unchanged"
        ],
        "title": "BulkUpsertResult",
        "type": "object"
      },
      "CapacityPeriod": {
        "description": "Capacity valid from this local date until the next period starts.",
        "properties": {
          "capacity": {
            "exclusiveMinimum": 0.0,
            "title": "Capacity",
            "type": "integer"
          },
          "valid_from": {
            "format": "date",
            "title": "Valid From",
            "type": "string"
          }
        },
        "required": [
          "valid_from",
          "capacity"
        ],
        "title": "CapacityPeriod",
        "type": "object"
      },
      "GateOut": {
        "properties": {
          "direction": {
            "enum": [
              "entry",
              "exit"
            ],
            "title": "Direction",
            "type": "string"
          },
          "gate_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Gate Id",
            "type": "string"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "gate_id",
          "lot_id",
          "direction",
          "name"
        ],
        "title": "GateOut",
        "type": "object"
      },
      "GateUpsert": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "enum": [
              "entry",
              "exit"
            ],
            "title": "Direction",
            "type": "string"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "lot_id",
          "direction",
          "name"
        ],
        "title": "GateUpsert",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthStatus",
        "type": "object"
      },
      "LotOut": {
        "properties": {
          "capacity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Capacity of the period with the latest valid_from on or before today (service time zone). Null when every period starts in the future: there is no current capacity yet.",
            "title": "Capacity"
          },
          "capacity_history": {
            "description": "Sorted by valid_from.",
            "items": {
              "$ref": "#/components/schemas/CapacityPeriod"
            },
            "title": "Capacity History",
            "type": "array"
          },
          "gates": {
            "description": "Sorted by gate_id.",
            "items": {
              "$ref": "#/components/schemas/GateOut"
            },
            "title": "Gates",
            "type": "array"
          },
          "lot_id": {
            "pattern": "^[a-z0-9-]{2,40}$",
            "title": "Lot Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "lot_id",
          "name",
          "capacity",
          "capacity_history",
          "gates"
        ],
        "title": "LotOut",
        "type": "object"
      },
      "LotUpsert": {
        "additionalProperties": false,
        "properties": {
          "capacity_history": {
            "items": {
              "$ref": "#/components/schemas/CapacityPeriod"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Capacity History",
            "type": "array"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "capacity_history"
        ],
        "title": "LotUpsert",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "database": {
            "const": "ok",
            "default": "ok",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Readiness",
        "type": "object"
      },
      "StudentBulkUpsert": {
        "additionalProperties": false,
        "properties": {
          "student_refs": {
            "description": "Repeated refs in one body count once.",
            "items": {
              "pattern": "^stu_[0-9a-f]{12}$",
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Student Refs",
            "type": "array"
          }
        },
        "required": [
          "student_refs"
        ],
        "title": "StudentBulkUpsert",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "UNDB Campus Parking API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/gates/{gate_id}": {
      "put": {
        "description": "A gate's lot and direction are fixed from creation; only the name may change. 201 when created, 200 when it existed.",
        "operationId": "put_gate_api_v1_admin_gates__gate_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "gate_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9-]{2,40}$",
              "title": "Gate Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GateUpsert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateOut"
                }
              }
            },
            "description": "Gate created."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create or rename a gate",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/lots/{lot_id}": {
      "put": {
        "description": "Replaces the lot's name and its whole capacity history; the same body twice leaves the same state. 201 when the lot was created, 200 when it existed.",
        "operationId": "put_lot_api_v1_admin_lots__lot_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "lot_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9-]{2,40}$",
              "title": "Lot Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LotUpsert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotOut"
                }
              }
            },
            "description": "Lot created."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create or replace a lot",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/students/bulk": {
      "post": {
        "description": "Insert-ignore: known refs are left as they are. Repeats in the body count once.",
        "operationId": "bulk_students_api_v1_admin_students_bulk_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentBulkUpsert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkUpsertResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Register students in bulk",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/lots": {
      "get": {
        "operationId": "list_lots_api_v1_lots_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LotOut"
                  },
                  "title": "Response List Lots Api V1 Lots Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List lots",
        "tags": [
          "lots"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)."
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes.",
      "name": "health"
    },
    {
      "description": "Public lot registry: capacity and gates.",
      "name": "lots"
    },
    {
      "description": "Registry writes (admin API key).",
      "name": "admin"
    }
  ]
}
