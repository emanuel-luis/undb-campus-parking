{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // The security gate of the npm workspace: a high or critical advisory in a production
  // dependency fails the npm-audit job (security.yml). Dev tooling never ships.
  "high": true,
  "skip-dev": true,
  "report-type": "summary",
  // No accepted advisories (docs/DECISIONS.md rows 66 and 74). An exception, when one is needed,
  // is scoped to one dependency path as `npm ci` lays out package-lock.json ("GHSA-...|a>b>c"),
  // so the same advisory reached through any other package still fails, and it carries an
  // expiry so the job fails again and the exception is reviewed.
  "allowlist": []
}
